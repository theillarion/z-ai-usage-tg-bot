# Токен вашего Telegram-бота (от @BotFather)
BOT_TOKEN=123456789:AAH...

# Ваш Telegram ID (бот будет отвечать только вам)
# Узнать можно через бота @userinfobot
OWNER_ID=123456789

# Опционально: Прокси для Telegram (если api.telegram.org блокируется или тормозит)
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_PROXY=http://user:pass@192.168.1.1:8080

# Опционально: Локальный Telegram Bot API сервер
# TELEGRAM_API_SERVER=http://127.0.0.1:8081

